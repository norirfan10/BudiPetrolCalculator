<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/AppToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/calculate"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Input Card -->
            <androidx.cardview.widget.CardView
                style="@style/CardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fuel Details"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:layout_marginBottom="16dp" />

                    <!-- Petrol Type Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_petrol_type"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Petrol Type Radio Group -->
                    <RadioGroup
                        android:id="@+id/rgPetrolType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <RadioButton
                            android:id="@+id/rbRon95"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RON95"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_blue"
                            android:textSize="14sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbRon97"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RON97"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_blue"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rbDiesel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Diesel"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_blue"
                            android:textSize="14sp" />

                    </RadioGroup>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="20dp" />

                    <!-- Fixed Price Display -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_price"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvPriceDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_result_card"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:text="RM 3.87 / litre"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Input Mode Toggle Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Input Mode"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Toggle: Litres / Amount RM -->
                    <RadioGroup
                        android:id="@+id/rgInputMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rbByLitres"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="By Litres"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_blue"
                            android:textSize="14sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbByAmount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="By Amount (RM)"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/primary_blue"
                            android:textSize="14sp" />

                    </RadioGroup>

                    <!-- Fuel Usage in Litres (shown when By Litres selected) -->
                    <LinearLayout
                        android:id="@+id/layoutInputLitres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_usage"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:boxStrokeColor="@color/primary_blue"
                            app:hintTextColor="@color/primary_blue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFuelUsage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. 40"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Amount in RM (shown when By Amount selected) -->
                    <LinearLayout
                        android:id="@+id/layoutInputAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petrol Amount (RM)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:boxStrokeColor="@color/primary_blue"
                            app:hintTextColor="@color/primary_blue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAmountRm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. 50.00"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- BUDI MADANI Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBudi"
                style="@style/CardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BUDI MADANI"
                                android:textColor="@color/primary_blue"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvBudiSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fuel Subsidy Programme"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <!-- Subsidy rate badge -->
                        <TextView
                            android:id="@+id/tvSubsidyBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RM1.99/l"
                            android:textColor="@color/primary_blue"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_result_card"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <!-- Not applicable notice (shown for non-RON95) -->
                    <TextView
                        android:id="@+id/tvBudiNotApplicable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/budi_not_applicable"
                        android:textColor="@color/disabled_grey"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                    <!-- BUDI Eligible Badge (shown for RON95) -->
                    <TextView
                        android:id="@+id/tvBudiEligibleBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓  BUDI MADANI Eligible"
                        android:textColor="@color/success_green"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_savings_card"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnReset"
                    style="@style/OutlineButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_reset" />

                <Button
                    android:id="@+id/btnCalculate"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_calculate_now" />

            </LinearLayout>

            <!-- Results Section (hidden initially) -->
            <LinearLayout
                android:id="@+id/layoutResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Result Card -->
                <androidx.cardview.widget.CardView
                    style="@style/CardStyle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/result_title"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true"
                            android:layout_marginBottom="16dp" />

                        <!-- Total Petrol Cost Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_total_cost"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvTotalCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RM 0.00"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Petrol Amount in Litres Row -->
                        <LinearLayout
                            android:id="@+id/rowPetrolLitres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Petrol Amount"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvPetrolLitres"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00 L"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="12dp" />

                        <!-- BUDI Rebate Row -->
                        <LinearLayout
                            android:id="@+id/rowBudiRebate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_budi_rebate"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvBudiRebate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="- RM 0.00"
                                android:textColor="#E53935"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:id="@+id/dividerFinal"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="12dp" />

                        <!-- Final Payable -->
                        <LinearLayout
                            android:id="@+id/rowFinalPayable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/result_final_payable"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFinalPayable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RM 0.00"
                                android:textColor="@color/primary_blue"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Total Savings Banner -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSavings"
                    style="@style/CardStyle"
                    app:cardBackgroundColor="@color/savings_green_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="&#128176;"
                            android:textSize="20sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/result_total_saving"
                                android:textColor="@color/success_green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="via BUDI MADANI subsidy"
                                android:textColor="@color/success_green"
                                android:textSize="11sp"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalSaving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RM 0.00"
                            android:textColor="@color/success_green"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
